# ==============================================================================
# Consterna Cloud - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como `.env` en la raíz del proyecto y ajusta los valores.
# ==============================================================================

# Entorno de ejecución ("development" para local)
FASTAPI_ENV=development

# Nombre del proyecto y clave secreta JWT (cambiar obligatoriamente en producción)
PROJECT_NAME="Consterna Cloud Engine"
SECRET_KEY=changethis_in_production_use_strong_random_key

# Credenciales del Superusuario inicial
FIRST_SUPERUSER=admin@consterna.cloud
FIRST_SUPERUSER_PASSWORD=changethis

# Configuración SMTP / Correos
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
SMTP_SSL=False
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@consterna.cloud
EMAILS_FROM_NAME="Consterna Cloud"

# Base de Datos (SQLite para desarrollo local / PostgreSQL en Docker Compose)
DATABASE_URL=sqlite:///./consterna.db
POSTGRES_PASSWORD=changethis

# Monitoreo opcional
SENTRY_DSN=
DOMAIN=localhost
